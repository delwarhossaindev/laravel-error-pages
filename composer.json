{
    "name": "acibd/laravel-error-pages",
    "description": "Beautiful pre-styled Laravel error pages (403, 404, 500, 503) with SVG illustrations for AdminLTE / Bootstrap apps.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "error-pages",
        "403",
        "404",
        "500",
        "503",
        "adminlte",
        "bootstrap"
    ],
    "authors": [
        {
            "name": "Delwar Hossain",
            "email": "acimiswebapps@gmail.com",
            "homepage": "https://github.com/delwarhossaindev"
        }
    ],
    "homepage": "https://github.com/delwarhossaindev/laravel-error-pages",
    "support": {
        "issues": "https://github.com/delwarhossaindev/laravel-error-pages/issues",
        "source": "https://github.com/delwarhossaindev/laravel-error-pages"
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Acibd\\ErrorPages\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Acibd\\ErrorPages\\ErrorPagesServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
